# Copia este archivo a .env y rellénalo. NUNCA subas .env a GitHub.

# --- IA (Groq) ---------------------------------------------------------------
# Clave de Groq (console.groq.com/keys)
GROQ_API_KEY=
# Modelo principal (opcional). Por defecto: openai/gpt-oss-120b
MODELO=
# Modelos de reserva si el principal agota su cupo diario (opcional)
MODELOS_RESERVA=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Modelo del verificador de datos (opcional)
MODELO_VERIFICADOR=openai/gpt-oss-20b

# --- Voz (edge-tts) ---------------------------------------------------------
# Lista de voces: edge-tts --list-voices
VOZ_ES=es-ES-AlvaroNeural
VOZ_EN=en-US-AndrewNeural
# Velocidad de la voz, p. ej. +0%, +8%, +15%
VELOCIDAD=+8%

# --- Wikimedia ---------------------------------------------------------------
# Contacto que se envía a Wikimedia al descargar (lo exige su normativa): una URL o un correo
WIKIMEDIA_CONTACTO=

# --- Actualidad -----------------------------------------------------------------
# Opcional: clave de Tavily (tavily.com) para buscar noticias. Sin ella se usa Bing Noticias (gratis).
TAVILY_API_KEY=

# --- YouTube -------------------------------------------------------------------
# Visibilidad por defecto al subir: private | unlisted | public
YT_PRIVACIDAD=private
# Programados: cuántas horas antes de su hora puede subirse cada vídeo (YouTube lo publica a su hora).
# Por defecto 720 (30 días): se sube en cuanto hay hueco en el límite diario.
PROGRAMADOS_ANTELACION_H=720
# Programados: subidas como mucho en 24 h (para no chocar con el límite de subidas de YouTube)
PROGRAMADOS_MAX_DIA=3
# 1 = los vídeos sin avisos del verificador se dan por revisados y se programan solos al generarse (0 = no)
AUTO_PROGRAMAR=1

# --- Menú -----------------------------------------------------------------------
# Puerto del menú web (por defecto 8765)
MENU_PUERTO=
